{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/home",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/index",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/index.html",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/about",
      "destination": "/api/site?page=about"
    },
    {
      "source": "/services",
      "destination": "/api/site?page=services"
    },
    {
      "source": "/projects",
      "destination": "/api/site?page=projects"
    },
    {
      "source": "/contact",
      "destination": "/api/site?page=contact"
    },
    {
      "source": "/interior",
      "destination": "/api/site?page=interior"
    },
    {
      "source": "/about.html",
      "destination": "/api/site?page=about"
    },
    {
      "source": "/services.html",
      "destination": "/api/site?page=services"
    },
    {
      "source": "/projects.html",
      "destination": "/api/site?page=projects"
    },
    {
      "source": "/contact.html",
      "destination": "/api/site?page=contact"
    },
    {
      "source": "/interior.html",
      "destination": "/api/site?page=interior"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "website-lib/templates/**"
    }
  }
}
