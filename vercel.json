{
  "functions": {
    "api/site.js": {
      "includeFiles": "website-lib/templates/**"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "^/api/(.*)$",
      "headers": {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/$",
      "dest": "/api/site?page=home"
    },
    {
      "src": "^/home$",
      "dest": "/api/site?page=home"
    },
    {
      "src": "^/index$",
      "dest": "/api/site?page=home"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/site?page=home"
    },
    {
      "src": "^/about$",
      "dest": "/api/site?page=about"
    },
    {
      "src": "^/services$",
      "dest": "/api/site?page=services"
    },
    {
      "src": "^/projects$",
      "dest": "/api/site?page=projects"
    },
    {
      "src": "^/contact$",
      "dest": "/api/site?page=contact"
    },
    {
      "src": "^/interior$",
      "dest": "/api/site?page=interior"
    },
    {
      "src": "^/about\\.html$",
      "dest": "/api/site?page=about"
    },
    {
      "src": "^/services\\.html$",
      "dest": "/api/site?page=services"
    },
    {
      "src": "^/projects\\.html$",
      "dest": "/api/site?page=projects"
    },
    {
      "src": "^/contact\\.html$",
      "dest": "/api/site?page=contact"
    },
    {
      "src": "^/interior\\.html$",
      "dest": "/api/site?page=interior"
    },
    {
      "handle": "filesystem"
    }
  ]
}
